# ── Supabase ────────────────────────────────────────────────────────────────
# Estos valores los encuentras en tu proyecto de Supabase:
# Settings → API → Project URL  y  Settings → API → anon public

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxx...

# Clave de servicio (service_role) — SOLO para el backend (api/analyze.js)
# Settings → API → service_role secret  ← ¡no la expongas en el frontend!
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# ── Anthropic ───────────────────────────────────────────────────────────────
# Crea la clave en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxx...
